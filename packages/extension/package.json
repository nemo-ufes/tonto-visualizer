{
    "name": "tonto-visualizer",
    "displayName": "Tonto Visualizer",
    "version": "0.1.61+20261017105645",
    "private": true,
    "description": "An OntoUML diagram beside the text: a Tonto model drawn as it is typed, and arranged by hand.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jpalmeida/tonto-visualizer.git",
        "directory": "packages/extension"
    },
    "type": "module",
    "publisher": "tonto-redesign",
    "categories": [
        "Visualization",
        "Programming Languages"
    ],
    "keywords": [
        "tonto",
        "ontouml",
        "ufo",
        "ontology",
        "diagram"
    ],
    "engines": {
        "vscode": "^1.90.0"
    },
    "main": "./out/extension.cjs",
    "activationEvents": [
        "onLanguage:tonto"
    ],
    "contributes": {
        "commands": [
            {
                "command": "tonto.viz.open",
                "title": "Open Diagram",
                "category": "Tonto",
                "icon": "$(symbol-structure)"
            },
            {
                "command": "tonto.viz.autoLayout",
                "title": "Arrange Diagram Automatically",
                "category": "Tonto"
            },
            {
                "command": "tonto.viz.exportSvg",
                "title": "Export Diagram as SVG",
                "category": "Tonto"
            },
            {
                "command": "tonto.viz.exportPng",
                "title": "Export Diagram as PNG",
                "category": "Tonto"
            },
            {
                "command": "tonto.viz.openView",
                "title": "Open Diagram View",
                "category": "Tonto"
            },
            {
                "command": "tonto.viz.saveNamedView",
                "title": "Save Diagram as Named View",
                "category": "Tonto"
            },
            {
                "command": "tonto.viz.undo",
                "title": "Undo Diagram Change",
                "category": "Tonto"
            },
            {
                "command": "tonto.viz.redo",
                "title": "Redo Diagram Change",
                "category": "Tonto"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "tonto.viz.open",
                    "when": "editorLangId == 'tonto'"
                },
                {
                    "command": "tonto.viz.autoLayout",
                    "when": "tontoVizOpen"
                },
                {
                    "command": "tonto.viz.exportSvg",
                    "when": "tontoVizOpen"
                },
                {
                    "command": "tonto.viz.openView",
                    "when": "tontoVizOpen"
                },
                {
                    "command": "tonto.viz.saveNamedView",
                    "when": "tontoVizOpen"
                }
            ],
            "editor/title": [
                {
                    "command": "tonto.viz.open",
                    "when": "editorLangId == 'tonto'",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "tonto.viz.open",
                    "when": "resourceExtname == '.tonto'",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Tonto Visualizer",
            "properties": {
                "tonto.viz.update": {
                    "type": "string",
                    "enum": [
                        "onType",
                        "onSave"
                    ],
                    "default": "onType",
                    "scope": "window",
                    "markdownDescription": "When the diagram catches up with the text. `onType` redraws as the model is written, keeping the last good picture while it does not parse; `onSave` waits."
                },
                "tonto.viz.followActiveEditor": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "markdownDescription": "Follow the editor: opening another `.tonto` file draws that file's packages. Turn off to keep one diagram on screen while reading elsewhere."
                },
                "tonto.viz.saveArrangement": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "markdownDescription": "After you change an automatically arranged diagram, save it under the model's `views` folder so the hand-arranged view survives a restart and can be committed."
                }
            }
        }
    },
    "files": [
        "out",
        "media",
        "LICENSE"
    ],
    "scripts": {
        "clean": "shx rm -rf out",
        "prebuild": "npm run clean",
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "package": "node bump-version.mjs && npm run build && vsce package --no-dependencies",
        "test": "vitest run"
    },
    "dependencies": {
        "tonto-canvas": "*",
        "tonto-view": "*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.1",
        "happy-dom": "^15.11.7",
        "shx": "^0.3.4",
        "typescript": "^5.6.0",
        "vitest": "^2.1.4"
    }
}
