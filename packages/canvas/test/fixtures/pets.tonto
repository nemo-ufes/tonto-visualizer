// 	topic: string
// 	notes: string [0..1]
// 	@mediation [*] -- [1] Pet
// 	@mediation [*] -- [1] PetTutor
// }

relator ClinicVisit {
	visitDate: date
	reason: string
	diagnosis: string [0..1]
	treatment: string [0..1]
	// @material [0..*] -- name -- [0..*] (const target) Target
	@mediation [*] -- [1] (const pet) Pet
	@mediation [*] -- [1] (const) PetClinic
	// @mediation [*] -- [1] Veterinarian
}
// kind Target

@mediation 
relation ClinicVisit [*] -- involvesVet -- [1] (const vet) Veterinarian

