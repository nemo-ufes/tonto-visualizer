{
    "name": "tonto-visualizer",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "language": "npm --prefix vendor/tonto install --no-audit --no-fund && npm --prefix vendor/tonto run build --workspace=tonto-language",
        "build": "npm run build --workspace=tonto-view --workspace=tonto-canvas --workspace=tonto-view-cli --workspace=tonto-visualizer",
        "test": "npm run test --workspace=tonto-view --workspace=tonto-canvas --workspace=tonto-visualizer",
        "lint": "npm run lint --workspaces --if-present",
        "typecheck": "tsc -p packages/extension/tsconfig.json --noEmit",
        "package": "npm run build && npm run package --workspace=tonto-visualizer"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    },
    "engines": {
        "node": ">=22"
    }
}
